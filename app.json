{
  "expo": {
    "name": "Aarambh News",
    "slug": "aarambh-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aarambhnews",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aarambh.news",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aarambh News uses your location to show hyperlocal news from your city and district.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aarambh News uses your location to show hyperlocal news from your city and district."
      }
    },
    "android": {
      "package": "com.aarambh.news",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-video",
      "expo-audio",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Aarambh News to use your location for hyperlocal news."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aarambh News to access photos for news submissions."
        }
      ],
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "be1cca30-db67-4709-a407-f3c830ee556a"
      }
    }
  }
}
